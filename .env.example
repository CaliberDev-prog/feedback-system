# Discord webhook URL for receiving feedback submissions.
# Create a webhook in your Discord server channel settings.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Admin password for accessing the dashboard.
# Use a strong, unique password.
ADMIN_PASSWORD=your-secure-admin-password

# Secret key used for signing session tokens.
# Generate a random 64-character string.
SESSION_SECRET=your-random-session-secret-at-least-64-characters-long

# Optional: Override the CORS origin for API requests.
# Set to the full URL of your frontend if hosted on a different domain.
# Leave empty to allow the Worker's own domain.
CORS_ORIGIN=

# Optional: Rate limiting configuration (defaults shown below).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW=60
# ADMIN_SESSION_TTL=86400
