{
  "name": "universal-feedback-system",
  "version": "1.0.0",
  "description": "A modern, professional, reusable feedback system for any Discord server, business, community, project, or organization.",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "publish": "wrangler deploy",
    "new": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/new-server.ps1",
    "new:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/new-server.ps1 -DryRun",
    "lint": "echo 'No linter configured yet'",
    "format": "prettier --write \"**/*.{js,json,css,md}\""
  },
  "keywords": [
    "feedback",
    "discord",
    "survey",
    "cloudflare-workers",
    "form"
  ],
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.9.8",
    "wrangler": "^3.0.0"
  }
}
